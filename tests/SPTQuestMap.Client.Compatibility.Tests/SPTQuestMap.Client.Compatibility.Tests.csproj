<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EftInstallRoot Condition="'$(EftInstallRoot)' == ''">$(SPT_ROOT)</EftInstallRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.3.1" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.1" />
    <Compile Include="../../src/SPTQuestMap.Client/Compatibility/ClientBuildPolicy.cs" Link="ClientBuildPolicy.cs" />
    <Compile Include="../../src/SPTQuestMap.Client/Compatibility/NativeTargetContract.cs" Link="NativeTargetContract.cs" />
    <Compile Include="../../src/SPTQuestMap.Client/Compatibility/NativeTargetValidation.cs" Link="NativeTargetValidation.cs" />
    <AssemblyMetadata Include="EftInstallRoot" Value="$(EftInstallRoot)" />
  </ItemGroup>
</Project>
