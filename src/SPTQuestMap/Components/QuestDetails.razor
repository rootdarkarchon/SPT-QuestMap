@using System.Globalization

<aside class="details" aria-label="@Localizer["details.aria"]">
    @if (State.SelectedNode is not { } node)
    {
        <div class="empty-details"><span class="empty-icon">◇</span><h2>@Localizer["details.selectTitle"]</h2><p>@Localizer["details.selectHelp"]</p></div>
    }
    else
    {
        var questState = State.SelectedQuestState;
        var comparisonState = State.GetComparisonQuestState(node.Id);
        var traderState = State.GetTraderState(node.TraderId);
        var comparisonTraderState = State.GetComparisonTraderState(node.TraderId);
        var displayMaps = DisplayMaps(node);
        <div class="detail-banners">
            <div class="detail-header">
                @if (!string.IsNullOrWhiteSpace(node.ImageUrl)) { <img src="@node.ImageUrl" alt=""> }
                @if (!string.IsNullOrWhiteSpace(node.WikiUrl) || node.ScavRepeatable)
                {
                    <div class="detail-header-actions">
                        @if (!string.IsNullOrWhiteSpace(node.WikiUrl))
                        {
                            <a class="wiki-button" href="@node.WikiUrl" target="_blank" rel="noopener noreferrer">@Localizer["details.wiki"]</a>
                        }
                        @if (node.ScavRepeatable) { <span class="scav-quest-badge">@Localizer["repeatable.scav"]</span> }
                    </div>
                }
                <div class="detail-heading"><h2>@node.Name</h2></div>
            </div>
            <div class="location-detail" style="--location-map-count: @displayMaps.Length">
                <div class="location-detail-images" aria-hidden="true">
                    @foreach (var map in displayMaps)
                    {
                        <span><img src="@(map.BannerImageUrl ?? "/files/banners/norvinskzone.png")" alt=""></span>
                    }
                </div>
                <div class="location-detail-labels">
                    @foreach (var map in displayMaps)
                    {
                        <strong>@map.Name</strong>
                    }
                </div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(node.Summary))
        {
            <div class="detail-text-tabs" role="tablist" aria-label="@Localizer["details.textTabs"]">
                <button type="button" role="tab" class="@(State.DetailTextTab == QuestDetailTextTab.Description ? "active" : null)" aria-selected="@(State.DetailTextTab == QuestDetailTextTab.Description ? "true" : "false")" @onclick="() => SelectTextTabAsync(QuestDetailTextTab.Description)">@Localizer["details.description"]</button>
                <button type="button" role="tab" class="@(State.DetailTextTab == QuestDetailTextTab.Summary ? "active" : null)" aria-selected="@(State.DetailTextTab == QuestDetailTextTab.Summary ? "true" : "false")" @onclick="() => SelectTextTabAsync(QuestDetailTextTab.Summary)">@Localizer["details.summary"]</button>
            </div>
            @if (State.DetailTextTab == QuestDetailTextTab.Summary)
            {
                <div role="tabpanel" class="summary-panel">
                    <RichTextBlock Value="@node.Summary" Localizer="@Localizer" />
                    <p class="summary-disclaimer">@Localizer["details.summaryDisclaimer"]</p>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(node.Description))
            {
                <div role="tabpanel"><RichTextBlock Value="@node.Description" Localizer="@Localizer" /></div>
            }
        }
        else if (!string.IsNullOrWhiteSpace(node.Description))
        {
            <RichTextBlock Value="@node.Description" Localizer="@Localizer" />
        }
        @if (node.RelevantItems.Length > 0)
        {
            <section class="detail-section relevant-items-section">
                <h3>@Localizer["details.relevantItems"]</h3>
                <ul class="plain-list relevant-items-list">
                    @foreach (var item in node.RelevantItems)
                    {
                        <li><span class="relevant-item-name rich-description">@((MarkupString)RelevantItemMarkup(item.Name))</span>@if (!item.FleaEligible) { <span class="flea-ineligible"> (@Localizer["details.fleaIneligible"])</span> }</li>
                    }
                </ul>
            </section>
        }
        @if (State.CompareMode)
        {
            var comparison = State.GetComparison(node.Id);
            <section class="detail-section comparison-section">
                <h3>@Localizer["compare.progress"]</h3>
                <div class="comparison-summary @(comparison.HasDifferences ? "changed" : "matching")">
                    <strong>@Localizer.Format(comparison.HasDifferences ? "compare.changeCount" : "compare.noChanges", ("count", comparison.Categories.Length))</strong>
                    @if (comparison.HasDifferences)
                    {
                        <div class="comparison-category-list">
                            @foreach (var category in comparison.Categories)
                            {
                                <span class="comparison-category">@CategoryLabel(category, true)</span>
                            }
                        </div>
                    }
                </div>
                @ComparisonSummary(node, questState, comparisonState, traderState, comparisonTraderState)
            </section>
        }
        else
        {
            <section class="detail-section">
                <h3>@Localizer["details.trader"]</h3>
                <div class="trader-detail">
                    @if (!string.IsNullOrWhiteSpace(node.TraderImageUrl)) { <img src="@node.TraderImageUrl" alt=""> }
                    <p>@TraderSummary(node, traderState)</p>
                </div>
            </section>
        }
        @if (State.CompareMode || questState?.DisplayState is not ("Completed" or "InProgress" or "ReadyToFinish"))
        {
            <section class="detail-section"><h3>@Localizer["details.effectiveGates"]</h3>@RequirementList(node.EffectiveRequirements)</section>
        }
        @if (!State.CompareMode && questState?.AvailableAfter is > 0)
        {
            <section class="detail-section"><h3>@Localizer["details.availableAfter"]</h3><p>@FormatAvailableAfter(questState.AvailableAfter.Value)</p></section>
        }
        @if (!State.CompareMode && questState?.Blockers.Length > 0)
        {
            <section class="detail-section"><h3>@Localizer["details.currentBlockers"]</h3><ul class="plain-list">@foreach (var blocker in questState.Blockers) { <li>@BlockerText(blocker)</li> }</ul></section>
        }
        @if (!State.CompareMode && questState?.Exclusion is { } exclusion)
        {
            <section class="detail-section"><h3>@Localizer["details.mutualExclusion"]</h3><p>@Localizer["exclusion.prefix"] <button class="relation-button" type="button" @onclick="() => SelectRelation(exclusion.CausedByQuestId)">@QuestName(exclusion.CausedByQuestId)</button> (@StateLabel(exclusion.CauseStatus)@(exclusion.Permanent ? $", {Localizer["exclusion.permanent"]}" : string.Empty)).</p></section>
        }
        @if (node.ExclusionRules.Length > 0)
        {
            <section class="detail-section"><h3>@Localizer["details.branchAlternatives"]</h3>@RelationList(node.ExclusionRules.Select(rule => rule.CausedByQuestId))</section>
        }
        <section class="detail-section"><h3>@Localizer["details.objectives"]</h3>@(State.CompareMode ? ComparisonObjectiveList(node, questState, comparisonState) : ObjectiveList(node, questState))</section>
        <section class="detail-section"><h3>@Localizer["details.rewards"]</h3>@RewardList(node.Rewards)</section>
        <section class="detail-section"><h3>@Localizer["details.prerequisites"]</h3>@RelationList(State.Incoming(node.Id).Select(item => item.Edge.SourceId))</section>
        <section class="detail-section"><h3>@Localizer["details.successors"]</h3>@RelationList(State.Outgoing(node.Id).Select(item => item.Edge.TargetId))</section>
    }
</aside>

@code {
    [Parameter, EditorRequired] public QuestMapPageState State { get; set; } = default!;
    [Parameter, EditorRequired] public QuestMapLocalizer Localizer { get; set; } = default!;
    [Parameter] public EventCallback<string> QuestSelected { get; set; }
    [Parameter] public EventCallback<QuestDetailTextTab> DetailTextTabChanged { get; set; }

    private CultureInfo NumberCulture { get { try { return CultureInfo.GetCultureInfo(Localizer.BrowserLocale); } catch { return CultureInfo.InvariantCulture; } } }
    private string Number(double? value) => value is null ? "?" : value.Value.ToString("0.##", NumberCulture);
    private string SignedNumber(double value) => value > 0 ? $"+{Number(value)}" : Number(value);
    private string StateLabel(string value) => Localizer[$"state.{value}"];
    private string QuestName(string? id) => id is null ? Localizer["common.unknownQuest"] : State.GetNode(id)?.Name ?? id;
    private string TraderName(string? id) => id is null ? Localizer["common.trader"] : State.Topology?.Traders.FirstOrDefault(trader => trader.Id == id)?.Name ?? id;
    private QuestMapReferenceDto[] DisplayMaps(QuestNodeDto node)
    {
        if (UsesActualMaps(node.Location) && node.ActualMapsComplete && node.ActualMaps.Length > 0) return node.ActualMaps;
        return
        [
            new QuestMapReferenceDto(
                node.Location.Id,
                node.Location.Any ? Localizer["location.any"] : node.Location.Name ?? node.Location.Id,
                node.Location.BannerImageUrl),
        ];
    }

    private static bool UsesActualMaps(QuestLocationDto location) =>
        location.Any || string.Equals(location.Id, "marathon", StringComparison.OrdinalIgnoreCase);

    private string TraderSummary(QuestNodeDto node, TraderStateDto? traderState) => traderState is null
        ? Localizer.Format("trader.noState", ("trader", node.TraderName))
        : Localizer.Format("trader.summary", ("trader", node.TraderName), ("availability", Localizer[traderState.Available ? "trader.unlocked" : "trader.unavailable"]), ("loyalty", traderState.LoyaltyLevel?.ToString() ?? "?"), ("standing", Number(traderState.Standing)));

    private RenderFragment ComparisonSummary(QuestNodeDto node, QuestStateDto? primary, QuestStateDto? comparison, TraderStateDto? primaryTrader, TraderStateDto? comparisonTrader) => builder =>
    {
        var primaryApplicable = State.IsPrimaryApplicable(node.Id);
        var comparisonApplicable = State.IsComparisonApplicable(node.Id);
        var rows = new List<ComparisonRow>
        {
            new(Localizer["compare.status"], StateValue(primary, primaryApplicable), StateValue(comparison, comparisonApplicable), primaryApplicable != comparisonApplicable || primary?.DisplayState != comparison?.DisplayState),
            new(Localizer["details.trader"], ProfileValue(primaryApplicable, TraderSummary(node, primaryTrader)), ProfileValue(comparisonApplicable, TraderSummary(node, comparisonTrader)), primaryApplicable != comparisonApplicable || primaryTrader != comparisonTrader),
            new(Localizer["details.currentBlockers"], ProfileValue(primaryApplicable, BlockerSummary(primary)), ProfileValue(comparisonApplicable, BlockerSummary(comparison)), primaryApplicable != comparisonApplicable || !Enumerable.SequenceEqual(primary?.Blockers ?? [], comparison?.Blockers ?? [])),
        };
        if (primary?.AvailableAfter is > 0 || comparison?.AvailableAfter is > 0)
        {
            rows.Add(new(Localizer["details.availableAfter"], ProfileValue(primaryApplicable, primary?.AvailableAfter is > 0 ? FormatAvailableAfter(primary.AvailableAfter.Value) : Localizer["common.none"]), ProfileValue(comparisonApplicable, comparison?.AvailableAfter is > 0 ? FormatAvailableAfter(comparison.AvailableAfter.Value) : Localizer["common.none"]), primaryApplicable != comparisonApplicable || primary?.AvailableAfter != comparison?.AvailableAfter));
        }
        if (primary?.Exclusion is not null || comparison?.Exclusion is not null)
        {
            rows.Add(new(Localizer["details.mutualExclusion"], ExclusionSummary(primary, primaryApplicable), ExclusionSummary(comparison, comparisonApplicable), primaryApplicable != comparisonApplicable || primary?.Exclusion != comparison?.Exclusion));
        }
        var changed = rows.Where(row => row.Different).ToArray();
        var matching = rows.Where(row => !row.Different).ToArray();
        var sequence = 0;
        if (changed.Length > 0) builder.AddContent(sequence++, ComparisonTable(changed, "changed-comparison-table"));
        if (matching.Length > 0)
        {
            builder.OpenElement(sequence++, "details"); builder.AddAttribute(sequence++, "class", "matching-comparison-details");
            builder.OpenElement(sequence++, "summary"); builder.AddContent(sequence++, Localizer.Format("compare.matchingFields", ("count", matching.Length))); builder.CloseElement();
            builder.AddContent(sequence++, ComparisonTable(matching, "matching-comparison-table"));
            builder.CloseElement();
        }
    };

    private RenderFragment ComparisonTable(IReadOnlyList<ComparisonRow> rows, string className) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "table"); builder.AddAttribute(sequence++, "class", $"comparison-table {className}");
        builder.OpenElement(sequence++, "thead"); builder.OpenElement(sequence++, "tr");
        builder.OpenElement(sequence++, "th"); builder.AddAttribute(sequence++, "scope", "col"); builder.CloseElement();
        AddProfileHeading("A", State.Profile?.Nickname ?? "-");
        AddProfileHeading("B", State.ComparisonProfile?.Nickname ?? "-");
        builder.CloseElement(); builder.CloseElement(); builder.OpenElement(sequence++, "tbody");
        foreach (var row in rows)
        {
            builder.OpenElement(sequence++, "tr"); if (row.Different) builder.AddAttribute(sequence++, "class", "different");
            builder.OpenElement(sequence++, "th"); builder.AddAttribute(sequence++, "scope", "row"); builder.AddContent(sequence++, row.Label); builder.CloseElement();
            builder.OpenElement(sequence++, "td"); builder.AddContent(sequence++, row.PrimaryValue); builder.CloseElement();
            builder.OpenElement(sequence++, "td"); builder.AddContent(sequence++, row.ComparisonValue); builder.CloseElement();
            builder.CloseElement();
        }
        builder.CloseElement(); builder.CloseElement();

        void AddProfileHeading(string label, string nickname)
        {
            builder.OpenElement(sequence++, "th"); builder.AddAttribute(sequence++, "scope", "col");
            builder.OpenElement(sequence++, "span"); builder.AddAttribute(sequence++, "class", $"profile-slot {(label == "A" ? "primary-slot" : "comparison-slot")}"); builder.AddContent(sequence++, label); builder.CloseElement();
            builder.AddContent(sequence++, nickname); builder.CloseElement();
        }
    };

    private string StateValue(QuestStateDto? questState, bool applicable) =>
        applicable ? StateLabel(questState?.DisplayState ?? "Locked") : Localizer["state.NotApplicable"];

    private string ProfileValue(bool applicable, string value) => applicable ? value : Localizer["state.NotApplicable"];

    private string BlockerSummary(QuestStateDto? questState) => questState?.Blockers.Length > 0
        ? string.Join("; ", questState.Blockers.Select(BlockerText))
        : Localizer["common.none"];

    private string ExclusionSummary(QuestStateDto? questState, bool applicable)
    {
        if (!applicable) return Localizer["state.NotApplicable"];
        if (questState?.Exclusion is not { } exclusion) return Localizer["common.none"];
        return $"{QuestName(exclusion.CausedByQuestId)} ({StateLabel(exclusion.CauseStatus)}{(exclusion.Permanent ? $", {Localizer["exclusion.permanent"]}" : string.Empty)})";
    }

    private string RequirementText(RequirementDto requirement)
    {
        if (requirement.Kind == "PrestigeLevel") return Localizer.Format("gates.prestigeLevel", ("compare", requirement.Compare), ("value", Number(requirement.Value)));
        if (requirement.Kind == "Level") return Localizer.Format("gates.pmcLevel", ("compare", requirement.Compare), ("value", Number(requirement.Value)));
        var kind = Localizer[requirement.Kind == "TraderLoyalty" ? "gates.loyaltyShort" : "gates.reputationShort"];
        return Localizer.Format("gates.reputation", ("trader", TraderName(requirement.TraderId)), ("kind", kind), ("compare", requirement.Compare), ("value", Number(requirement.Value)));
    }

    private string BlockerText(QuestBlockerDto blocker)
    {
        if (blocker.Kind == "Prerequisite") return Localizer.Format("blocker.prerequisite", ("quest", QuestName(blocker.SubjectId)), ("statuses", string.Join(Localizer["common.or"], blocker.RequiredStatuses.Select(StateLabel))));
        if (blocker.Kind == "TraderUnavailable") return Localizer.Format("blocker.traderUnavailable", ("trader", TraderName(blocker.SubjectId)));
        if (blocker.Kind == "PrestigeLevel") return Localizer.Format("gates.prestigeLevel", ("compare", blocker.Compare), ("value", Number(blocker.RequiredValue)));
        if (blocker.Kind == "Level") return Localizer.Format("gates.pmcLevel", ("compare", blocker.Compare), ("value", Number(blocker.RequiredValue)));
        var kind = Localizer[blocker.Kind == "TraderLoyalty" ? "gates.loyaltyShort" : "gates.reputationShort"];
        return Localizer.Format("gates.reputation", ("trader", TraderName(blocker.SubjectId)), ("kind", kind), ("compare", blocker.Compare), ("value", Number(blocker.RequiredValue)));
    }

    private string FormatAvailableAfter(double value) => value > 1_000_000_000
        ? DateTimeOffset.FromUnixTimeSeconds((long)value).ToLocalTime().ToString("g", NumberCulture)
        : Localizer.Format("time.seconds", ("value", Number(value)));

    private RenderFragment RequirementList(IReadOnlyList<RequirementDto> requirements) => builder =>
    {
        if (requirements.Count == 0)
        {
            builder.OpenElement(0, "p"); builder.AddAttribute(1, "class", "muted"); builder.AddContent(2, Localizer["gates.none"]); builder.CloseElement();
            return;
        }
        builder.OpenElement(3, "ul"); builder.AddAttribute(4, "class", "plain-list");
        var sequence = 5;
        foreach (var requirement in requirements) { builder.OpenElement(sequence++, "li"); builder.AddContent(sequence++, RequirementText(requirement)); builder.CloseElement(); }
        builder.CloseElement();
    };

    private RenderFragment ObjectiveList(QuestNodeDto node, QuestStateDto? questState) => builder =>
    {
        if (node.Objectives.Length == 0) { builder.OpenElement(0, "p"); builder.AddAttribute(1, "class", "muted"); builder.AddContent(2, Localizer["objectives.none"]); builder.CloseElement(); return; }
        var progress = (questState?.Objectives ?? []).ToDictionary(item => item.ObjectiveId, StringComparer.Ordinal);
        builder.OpenElement(3, "ol"); builder.AddAttribute(4, "class", "objectives"); var sequence = 5;
        foreach (var objective in node.Objectives)
        {
            var item = progress.GetValueOrDefault(objective.Id);
            builder.OpenElement(sequence++, "li"); if (item?.Complete == true) builder.AddAttribute(sequence++, "class", "complete");
            builder.OpenElement(sequence++, "span"); builder.AddAttribute(sequence++, "class", "objective-marker"); builder.AddContent(sequence++, item?.Complete == true ? "✓" : "○"); builder.CloseElement();
            builder.OpenElement(sequence++, "div"); builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "objective-description rich-description"); builder.AddMarkupContent(sequence++, ObjectiveMarkup(objective)); builder.CloseElement();
            var detail = item?.Current is not null && item.Required is not null ? $"{Number(item.Current)} / {Number(item.Required)}" : item?.Required is not null ? Localizer.Format("objectives.required", ("value", Number(item.Required))) : item?.ProgressKnown == true && !item.Complete ? Localizer["objectives.progressRecorded"] : null;
            if (detail is not null) { builder.OpenElement(sequence++, "small"); builder.AddContent(sequence++, detail); builder.CloseElement(); }
            builder.CloseElement(); builder.CloseElement();
        }
        builder.CloseElement();
    };

    private RenderFragment ComparisonObjectiveList(QuestNodeDto node, QuestStateDto? primaryState, QuestStateDto? comparisonState) => builder =>
    {
        if (node.Objectives.Length == 0) { builder.OpenElement(0, "p"); builder.AddAttribute(1, "class", "muted"); builder.AddContent(2, Localizer["objectives.none"]); builder.CloseElement(); return; }
        var primaryProgress = (primaryState?.Objectives ?? []).ToDictionary(item => item.ObjectiveId, StringComparer.Ordinal);
        var comparisonProgress = (comparisonState?.Objectives ?? []).ToDictionary(item => item.ObjectiveId, StringComparer.Ordinal);
        var primaryApplicable = State.IsPrimaryApplicable(node.Id);
        var comparisonApplicable = State.IsComparisonApplicable(node.Id);
        var items = node.Objectives.Select((objective, index) => new ComparisonObjective(
            objective,
            primaryProgress.GetValueOrDefault(objective.Id),
            comparisonProgress.GetValueOrDefault(objective.Id),
            !primaryApplicable || !comparisonApplicable || State.ObjectiveDiffers(objective.Id),
            index)).ToArray();
        var changed = items.Where(item => item.Different).OrderBy(item => item.Index).ToArray();
        var matching = items.Where(item => !item.Different).OrderBy(item => item.Index).ToArray();
        var sequence = 0;
        if (changed.Length > 0) builder.AddContent(sequence++, ObjectiveComparisonItems(changed, primaryApplicable, comparisonApplicable));
        if (matching.Length > 0)
        {
            builder.OpenElement(sequence++, "details"); builder.AddAttribute(sequence++, "class", "matching-objective-details");
            builder.OpenElement(sequence++, "summary"); builder.AddContent(sequence++, Localizer.Format("compare.matchingObjectives", ("count", matching.Length))); builder.CloseElement();
            builder.AddContent(sequence++, ObjectiveComparisonItems(matching, primaryApplicable, comparisonApplicable));
            builder.CloseElement();
        }
    };

    private RenderFragment ObjectiveComparisonItems(IReadOnlyList<ComparisonObjective> items, bool primaryApplicable, bool comparisonApplicable) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "ol"); builder.AddAttribute(sequence++, "class", "objectives comparison-objectives");
        foreach (var item in items)
        {
            builder.OpenElement(sequence++, "li"); if (item.Different) builder.AddAttribute(sequence++, "class", "different");
            builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "objective-description rich-description"); builder.AddMarkupContent(sequence++, ObjectiveMarkup(item.Objective)); builder.CloseElement();
            builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "objective-comparison");
            AddObjectiveLane("A", item.Primary, primaryApplicable);
            AddObjectiveLane("B", item.Comparison, comparisonApplicable);
            builder.CloseElement();
            if (ObjectiveDelta(item.Primary, item.Comparison) is { } delta)
            {
                builder.OpenElement(sequence++, "small"); builder.AddAttribute(sequence++, "class", "objective-delta"); builder.AddContent(sequence++, delta); builder.CloseElement();
            }
            builder.CloseElement();
        }
        builder.CloseElement();

        void AddObjectiveLane(string label, ObjectiveProgressDto? progress, bool applicable)
        {
            builder.OpenElement(sequence++, "span"); builder.AddAttribute(sequence++, "class", "objective-comparison-lane");
            builder.OpenElement(sequence++, "b"); builder.AddAttribute(sequence++, "class", $"profile-slot {(label == "A" ? "primary-slot" : "comparison-slot")}"); builder.AddContent(sequence++, label); builder.CloseElement();
            if (!applicable) builder.AddContent(sequence++, Localizer["state.NotApplicable"]);
            else
            {
                builder.OpenElement(sequence++, "span"); builder.AddAttribute(sequence++, "class", progress?.Complete == true ? "complete" : null); builder.AddContent(sequence++, progress?.Complete == true ? "✓" : "○"); builder.CloseElement();
                builder.AddContent(sequence++, ObjectiveProgressText(progress));
            }
            builder.CloseElement();
        }
    };

    private string? ObjectiveDelta(ObjectiveProgressDto? primary, ObjectiveProgressDto? comparison)
    {
        if (primary?.Current is not { } primaryCurrent || comparison?.Current is not { } comparisonCurrent || primary.Required != comparison.Required) return null;
        var delta = comparisonCurrent - primaryCurrent;
        if (delta == 0) return null;
        return Localizer.Format("compare.objectiveDelta", ("value", delta > 0 ? $"+{Number(delta)}" : Number(delta)));
    }

    private string ObjectiveProgressText(ObjectiveProgressDto? progress)
    {
        if (progress?.Current is not null && progress.Required is not null) return $"{Number(progress.Current)} / {Number(progress.Required)}";
        if (progress?.Required is not null) return Localizer.Format("objectives.required", ("value", Number(progress.Required)));
        if (progress?.Complete == true) return StateLabel("Completed");
        return progress?.ProgressKnown == true ? Localizer["objectives.progressRecorded"] : Localizer["common.none"];
    }

    internal static string ObjectiveMarkup(ObjectiveDefinitionDto objective) =>
        QuestRichTextSanitizer.Sanitize(objective.Text.Length > 0 ? objective.Text : objective.ConditionType);

    internal static string RelevantItemMarkup(string name) => QuestRichTextSanitizer.Sanitize(name);

    private RenderFragment RewardList(IReadOnlyList<QuestRewardDto> rewards) => builder =>
    {
        if (rewards.Count == 0) { builder.OpenElement(0, "p"); builder.AddAttribute(1, "class", "muted"); builder.AddContent(2, Localizer["common.none"]); builder.CloseElement(); return; }
        builder.OpenElement(3, "ul"); builder.AddAttribute(4, "class", "rewards"); var sequence = 5;
        foreach (var reward in rewards)
        {
            builder.OpenElement(sequence++, "li"); builder.AddAttribute(sequence++, "class", "reward-row");
            builder.OpenElement(sequence++, "span"); builder.AddAttribute(sequence++, "class", "reward-marker"); builder.AddContent(sequence++, "◆"); builder.CloseElement();
            builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "reward-body");
            foreach (var line in RewardLines(reward)) { builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "reward-description rich-description"); builder.AddMarkupContent(sequence++, QuestRichTextSanitizer.Sanitize(line)); builder.CloseElement(); }
            if (reward.Unknown) { builder.OpenElement(sequence++, "small"); builder.AddAttribute(sequence++, "class", "reward-unknown"); builder.AddContent(sequence++, Localizer["reward.unknown"]); builder.CloseElement(); }
            builder.CloseElement(); builder.CloseElement();
        }
        builder.CloseElement();
    };

    private IReadOnlyList<string> RewardLines(QuestRewardDto reward)
    {
        var items = reward.Items.Select(item => $"{item.Name} × {Number(item.Count)}").ToArray();
        var value = reward.Value is null ? string.Empty : SignedNumber(reward.Value.Value);
        var target = reward.TargetName ?? reward.TargetId ?? string.Empty;
        return reward.Type switch
        {
            "Item" => items.Length > 0 ? items : [target.Length > 0 ? target : reward.Type],
            "Experience" => [$"{Localizer["reward.experience"]} · {value}"],
            "Skill" => [$"{Localizer["reward.skill"]} · {target} {value}"],
            "TraderStanding" or "TraderStandingRestore" or "TraderStandingReset" => [$"{Localizer["reward.traderStanding"]} · {reward.TraderName ?? target} {value}"],
            "TraderUnlock" => [$"{Localizer["reward.unlock"]} · {reward.TraderName ?? target}"],
            "AssortmentUnlock" => (items.Length > 0 ? items : [target.Length > 0 ? target : reward.Type]).Select(item => $"{Localizer["reward.unlock"]} · {item}{(reward.TraderName is null ? string.Empty : $" · {reward.TraderName}")}{(reward.LoyaltyLevel is null ? string.Empty : $" LL{Number(reward.LoyaltyLevel)}")}").ToArray(),
            "ProductionScheme" => items.Length > 0 ? items.Select(item => $"{Localizer["reward.production"]} {item}").ToArray() : [$"{Localizer["reward.production"]} {target}"],
            "Achievement" => [$"{Localizer["reward.achievement"]} · {target}"],
            "Pockets" => [Localizer["reward.pockets"]],
            _ when reward.Type.StartsWith("Customization", StringComparison.Ordinal) => items.Length > 0 ? items.Select(item => $"{Localizer["reward.customization"]} · {item}").ToArray() : [$"{Localizer["reward.customization"]} · {target}"],
            _ => [$"{reward.Type}{(target.Length > 0 ? $" · {target}" : string.Empty)}{(value.Length > 0 ? $" · {value}" : string.Empty)}"],
        };
    }

    private RenderFragment RelationList(IEnumerable<string> values) => builder =>
    {
        var ids = values.Distinct(StringComparer.Ordinal).ToArray();
        if (ids.Length == 0) { builder.OpenElement(0, "p"); builder.AddAttribute(1, "class", "muted"); builder.AddContent(2, Localizer["common.none"]); builder.CloseElement(); return; }
        builder.OpenElement(3, "div"); builder.AddAttribute(4, "class", "relations"); var sequence = 5;
        foreach (var id in ids)
        {
            builder.OpenElement(sequence++, "button"); builder.AddAttribute(sequence++, "class", "relation-button"); builder.AddAttribute(sequence++, "type", "button"); builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => SelectRelation(id))); builder.AddContent(sequence++, QuestName(id)); builder.CloseElement();
        }
        builder.CloseElement();
    };

    private string CategoryLabel(QuestDifferenceCategory category, bool useProfileName) => category switch
    {
        QuestDifferenceCategory.PrimaryOnly when useProfileName => Localizer.Format("compare.category.PrimaryOnlyNamed", ("profile", State.Profile?.Nickname ?? "A")),
        QuestDifferenceCategory.ComparisonOnly when useProfileName => Localizer.Format("compare.category.ComparisonOnlyNamed", ("profile", State.ComparisonProfile?.Nickname ?? "B")),
        _ => Localizer[$"compare.category.{category}"],
    };

    private Task SelectRelation(string id) => QuestSelected.InvokeAsync(id);
    private Task SelectTextTabAsync(QuestDetailTextTab value) => DetailTextTabChanged.InvokeAsync(value);

    private sealed record ComparisonRow(string Label, string PrimaryValue, string ComparisonValue, bool Different);
    private sealed record ComparisonObjective(ObjectiveDefinitionDto Objective, ObjectiveProgressDto? Primary, ObjectiveProgressDto? Comparison, bool Different, int Index);
}
