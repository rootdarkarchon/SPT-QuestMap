@using System.Globalization

<aside class="in-progress-panel @(State.InProgressExpanded ? "expanded" : null)" aria-label="@Localizer["inProgress.title"]">
    <button class="in-progress-toggle" type="button" aria-expanded="@State.InProgressExpanded.ToString().ToLowerInvariant()" title="@Localizer["inProgress.title"]" @onclick="() => ExpandedChanged.InvokeAsync(!State.InProgressExpanded)">
        <span class="in-progress-title">@Localizer["inProgress.title"]</span><span class="in-progress-chevron" aria-hidden="true">@(State.InProgressExpanded ? "‹" : "›")</span>
    </button>
    <div class="in-progress-content">
        @if (State.InProgressGroups().Count == 0)
        {
            <p class="in-progress-empty">@Localizer["common.none"]</p>
        }
        @foreach (var group in State.InProgressGroups())
        {
            <section class="in-progress-group">
                <div class="in-progress-trader"><img src="@(group.Trader.ImageUrl ?? "/files/trader/avatar/unknown.png")" alt=""><strong>@group.Trader.Name</strong></div>
                @foreach (var quest in group.Quests)
                {
                    var comparison = State.GetComparison(quest.Node.Id);
                    <button class="in-progress-quest @(quest.Node.Id == State.SelectedId ? "selected" : null) @(State.CompareMode ? comparison.HasDifferences ? "comparison-changed" : "comparison-matching" : null)" type="button" @onclick="() => QuestSelected.InvokeAsync(quest.Node.Id)">
                        <span class="in-progress-quest-header"><strong>@quest.Node.Name</strong><span class="in-progress-location">@LocationName(quest.Node)</span></span>
                        @if (State.CompareMode)
                        {
                            @if (comparison.HasDifferences)
                            {
                                <span class="in-progress-difference-label">@DifferenceLabel(comparison)</span>
                            }
                            <span class="in-progress-compare">
                                @ProgressLane("A", quest.PrimaryState, State.IsPrimaryApplicable(quest.Node.Id))
                                @ProgressLane("B", quest.ComparisonState, State.IsComparisonApplicable(quest.Node.Id))
                            </span>
                        }
                        else
                        {
                            @ProgressMeter(quest.State.ProgressPercent)
                        }
                        @if (State.IsCollectorRoute(quest.Node.Id) || State.IsLightkeeperRoute(quest.Node.Id))
                        {
                            <span class="in-progress-route" title="@RouteTitle(quest.Node.Id)">
                                @if (State.IsCollectorRoute(quest.Node.Id)) { <i class="collector"></i> }
                                @if (State.IsLightkeeperRoute(quest.Node.Id)) { <i class="lightkeeper"></i> }
                            </span>
                        }
                    </button>
                }
            </section>
        }
    </div>
</aside>

@code {
    [Parameter, EditorRequired] public QuestMapPageState State { get; set; } = default!;
    [Parameter, EditorRequired] public QuestMapLocalizer Localizer { get; set; } = default!;
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }
    [Parameter] public EventCallback<string> QuestSelected { get; set; }

    private CultureInfo NumberCulture { get { try { return CultureInfo.GetCultureInfo(Localizer.BrowserLocale); } catch { return CultureInfo.InvariantCulture; } } }
    private static string LocationName(QuestNodeDto node) =>
        string.Join(", ", QuestMapLocationPresentation.DisplayMaps(node).Select(map => map.Name));
    private string RouteTitle(string id) => string.Join(" / ", new[] { State.IsCollectorRoute(id) ? Localizer["route.collector"] : null, State.IsLightkeeperRoute(id) ? Localizer["route.lightkeeper"] : null }.Where(value => value is not null));
    private string DifferenceLabel(QuestComparisonDto comparison) => $"{Localizer[$"compare.category.{comparison.Categories[0]}"]}{(comparison.Categories.Length > 1 ? $" +{comparison.Categories.Length - 1}" : string.Empty)}";

    private RenderFragment ProgressLane(string label, QuestStateDto? questState, bool applicable) => builder =>
    {
        builder.OpenElement(0, "span"); builder.AddAttribute(1, "class", "in-progress-compare-lane");
        builder.OpenElement(2, "b"); builder.AddContent(3, label); builder.CloseElement();
        if (!applicable || questState?.DisplayState != "InProgress")
        {
            builder.OpenElement(4, "small"); builder.AddContent(5, applicable ? Localizer[$"state.{questState?.DisplayState ?? "Locked"}"] : Localizer["state.NotApplicable"]); builder.CloseElement();
        }
        else
        {
            builder.AddContent(6, ProgressMeter(questState.ProgressPercent));
        }
        builder.CloseElement();
    };

    private RenderFragment ProgressMeter(double? value) => builder =>
    {
        var percent = Math.Clamp(value ?? 0, 0, 100);
        builder.OpenElement(0, "span"); builder.AddAttribute(1, "class", "in-progress-meter");
        builder.OpenElement(2, "i"); builder.AddAttribute(3, "style", $"width:{percent.ToString("0.##", CultureInfo.InvariantCulture)}%"); builder.CloseElement();
        builder.OpenElement(4, "span"); builder.AddContent(5, $"{percent.ToString("0.#", NumberCulture)}%"); builder.CloseElement();
        builder.CloseElement();
    };
}
